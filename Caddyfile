# Site block for lordkada.it — copy into the server's Caddyfile (or `import` it).
# Adjust `root` to wherever the contents of ./site are deployed.

lordkada.it, www.lordkada.it {
	root * /var/www/lordkada.it
	encode zstd gzip
	file_server

	@www host www.lordkada.it
	redir @www https://lordkada.it{uri} permanent

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'"
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=604800"
}
